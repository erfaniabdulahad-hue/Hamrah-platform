generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  password  String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id          String      @id @default(cuid())
  customerName String
  address     String
  total       Int
  status      String
  createdAt   DateTime    @default(now())
  items       OrderItem[]
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
}

model OrderItem {
  id       String @id @default(cuid())
  order    Order  @relation(fields: [orderId], references: [id])
  orderId  String
  title    String
  price    Int
  quantity Int
}

model Restaurant {
  id          String     @id @default(cuid())
  name        String
  description String?
  badge       String?
  eta         String?
  rating      Float?     @default(0)
  online      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  menu        MenuItem[]
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  title        String
  description  String?
  price        Int
  icon         String?
}
